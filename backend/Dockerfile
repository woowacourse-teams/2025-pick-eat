FROM eclipse-temurin:21-jre

WORKDIR /app

COPY build/libs/*.jar ./app.jar
COPY agent/opentelemetry-javaagent.jar /otel/opentelemetry-javaagent.jar

# Exporter 설정
ENV OTEL_TRACES_EXPORTER=otlp
ENV OTEL_METRICS_EXPORTER=none
ENV OTEL_LOGS_EXPORTER=none

# 프로토콜 설정
ENV OTEL_EXPORTER_OTLP_PROTOCOL=grpc
ENV OTEL_EXPORTER_OTLP_TIMEOUT=10000

# 압축
ENV OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# 재시도 3회
ENV OTEL_EXPORTER_OTLP_TRACES_RETRY_ENABLED=true
ENV OTEL_EXPORTER_OTLP_TRACES_RETRY_MAX_ATTEMPTS=3
ENV OTEL_EXPORTER_OTLP_TRACES_RETRY_INITIAL_INTERVAL=1000
ENV OTEL_EXPORTER_OTLP_TRACES_RETRY_MAX_INTERVAL=10000
ENV OTEL_EXPORTER_OTLP_TRACES_RETRY_BACKOFF_MULTIPLIER=2

# 샘플링
ENV OTEL_TRACES_SAMPLER=parentbased_traceidratio
ENV OTEL_TRACES_SAMPLER_ARG=1.00

# Batch 처리
ENV OTEL_BSP_SCHEDULE_DELAY=10000
ENV OTEL_BSP_MAX_QUEUE_SIZE=4096
ENV OTEL_BSP_MAX_EXPORT_BATCH_SIZE=1024
ENV OTEL_BSP_EXPORT_TIMEOUT=30000

# Span 제한 (메모리 보호)
ENV OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT=512
ENV OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT=64
ENV OTEL_SPAN_EVENT_COUNT_LIMIT=128
ENV OTEL_SPAN_LINK_COUNT_LIMIT=128

# 계측 설정
ENV OTEL_INSTRUMENTATION_COMMON_DEFAULT_ENABLED=true
ENV OTEL_INSTRUMENTATION_JDBC_STATEMENT_SANITIZER_ENABLED=true

# 로깅
ENV OTEL_JAVAAGENT_LOGGING=application

# Propagation
ENV OTEL_PROPAGATORS=tracecontext,baggage

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java -javaagent:/otel/opentelemetry-javaagent.jar ${JAVA_OPTS:-} -Dspring.profiles.active=${SPRING_ACTIVE_PROFILE:-dev} -jar /app/app.jar"]
